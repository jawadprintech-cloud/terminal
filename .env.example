# Copy to .env and replace the deployment URLs with your own domain.
# VITE_* values are public and are included in the browser bundle. Never put secrets here.
VITE_APP_TITLE="CBM Box Builder - 2D to 3D Design Tool"
VITE_APP_DESCRIPTION="Design custom packaging online in 2D on the dieline and preview it live in 3D."
VITE_APP_URL="https://your-domain.example/"
VITE_DEFAULT_QR_URL="https://your-store.example/"